{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Strata",
  "version": "0.0.0",
  "identifier": "me.pbeta.agent-strata",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "bun --cwd ../ui run dev",
    "beforeBuildCommand": "bun --cwd ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Strata",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
