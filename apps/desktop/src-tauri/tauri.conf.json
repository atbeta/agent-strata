{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Strata",
  "version": "0.0.0",
  "identifier": "me.pbeta.agent-strata",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Strata",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 17 },
        "backgroundColor": "#0f0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
