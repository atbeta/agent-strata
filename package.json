{
  "name": "agent-strata",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/desktop/ui"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:ui": "cd apps/desktop/ui && bun test && bunx vitest run",
    "check:secrets": "bun run scripts/check-secrets-perms.ts",
    "audit": "bun run scripts/audit.ts",
    "brand": "bun run scripts/brand.ts",
    "sidecar": "bun run scripts/build-sidecar.ts",
    "sidecar:force": "bun run scripts/build-sidecar.ts --force",
    "icons:providers": "bun run scripts/provider-icons.ts",
    "icons:windows": "bun run scripts/generate-windows-icon.ts",
    "lint": "oxlint --deny-warnings && bun run scripts/check-boundaries.ts",
    "typecheck": "bun run scripts/typecheck.ts"
  },
  "devDependencies": {
    "@agent-strata/adapter-opencode": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "^1.2.0",
    "oxlint": "^1.90.0",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.5.0"
  }
}
