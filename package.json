{
  "name": "agent-strata",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:ui": "bun test --cwd=apps/desktop/ui",
    "check:secrets": "bun run scripts/check-secrets-perms.ts",
    "brand": "bun run scripts/brand.ts",
    "sidecar": "bun run scripts/build-sidecar.ts",
    "sidecar:force": "bun run scripts/build-sidecar.ts --force",
    "icons:providers": "bun run scripts/provider-icons.ts",
    "typecheck": "rc=0; for p in packages/api packages/schema packages/store packages/projector packages/policy packages/adapter-acp packages/adapter-opencode packages/core packages/service apps/desktop/ui apps/desktop/ui/bench; do tsc --noEmit -p \"$p\" || rc=1; done; exit $rc"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "^1.2.0",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.5.0"
  }
}
